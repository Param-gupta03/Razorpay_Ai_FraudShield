# ==========================================
# FraudShield AI — Root Git Ignore
# ==========================================

# Large Data files (raw CSVs and processed split/feature pickles exceed GitHub's 100MB limit)
data/*.csv
data/processed/
data/*.pkl

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Pytest & Testing
.pytest_cache/
.coverage
htmlcov/

# Node.js & Next.js frontend builds
node_modules/
frontend/node_modules/
.next/
frontend/.next/
frontend/out/
frontend/build/

# Environment variables & secrets
.env
.env.local
.env.*.local

# Operating System & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
